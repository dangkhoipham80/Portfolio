# Copy to .env and fill in. .env is gitignored — never commit real values.
# A live Neon credential was once committed to this repo; that project has since
# been deleted, but keep secrets out of git.

# Application Settings
PROJECT_NAME=Portfolio API
VERSION=2.0.0
API_V1_STR=/api/v1

# Comma-separated. Must list the exact web origins in production — never "*".
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Postgres (Neon). Needs ?sslmode=require.
DATABASE_URL=

# Security. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Email. app/services/auth_service.py sends verification and password-reset mail
# through smtplib using these; leaving them unset makes those flows fail silently
# (the exception is caught and printed, not raised).
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=Portfolio Contact

# Set to "production" on Railway. Also switches /docs off.
ENVIRONMENT=development
DEBUG=True
